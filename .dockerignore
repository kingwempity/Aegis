# Git 与版本控制
.git
.gitignore
.gitattributes

# 前端依赖与构建产物（镜像内不跑前端构建，可大幅减小 context）
AFE/node_modules
AFE/dist
AFE/.vite
AFE/npm-debug.log*
AFE/yarn-debug.log*
AFE/yarn-error.log*
AFE/.env
AFE/.env.*

# 数据与持久化目录（运行时挂载，不参与构建）
data/

# Python 缓存与虚拟环境
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv
env
.env
.env.*

# IDE 与工具
.cursor
.vscode
.idea
*.swp
*.swo
*~

# 日志与临时文件
*.log
*.tmp
.cache

# 文档与无关文件（可选，进一步减小体积）
*.md
!README.md
